# ==============================================================================
# AutoDM Followers — Environment Configuration
# ==============================================================================

# Database (PostgreSQL / Neon / Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/autodm?schema=public"

# Auth & Session Security
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secure-random-32-byte-secret"

# Public App Base URL (Used for OAuth redirects & Meta webhook verification)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Meta / Instagram App Credentials (from developers.facebook.com)
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
META_APP_SECRET=""

# Instagram Webhook Verification Token (set same token in Meta App Dashboard)
VERIFY_TOKEN="your-random-webhook-verify-token"

# AES-256-GCM Token Encryption Key at rest (generate with: `openssl rand -hex 32`)
TOKEN_ENCRYPTION_KEY=""

# Safe Hourly Pacing Default (Engine prevents rate limit bans automatically)
HOURLY_REPLY_LIMIT="60"

# Testing & Local Emulation
# Set to "true" to test without connecting to actual Meta APIs
MOCK_INSTAGRAM_SEND="false"

# Transactional Delivery Emails (Optional - Brevo or Resend)
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="support@yourdomain.com"
BREVO_SENDER_NAME="AutoDM Support"

# Resend Alternative (Optional fallback)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="AutoDM Support <support@yourdomain.com>"

# Cron / Scheduler Protection
CRON_SECRET=""
