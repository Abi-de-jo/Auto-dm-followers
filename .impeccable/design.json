      "fontSize": "clamp(2.25rem, 3.6vw, 3.4rem)",
      "fontWeight": 400,
      "lineHeight": 0.9,
      "letterSpacing": "0.012em"
    },
    "hero": {
      "fontFamily": "Bebas Neue, sans-serif",
      "fontSize": "clamp(4.2rem, 9.2vw, 7.3rem)",
